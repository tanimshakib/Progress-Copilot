// Progress Copilot — Prisma schema (Phase 1)
// All user-owned data is tenant-isolated via userId.
// Timestamps are stored as timestamptz (DateTime in Prisma maps to it on Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TargetStatus {
  INCOMPLETE
  COMPLETED
}

enum Sender {
  USER
  AI
}

enum League {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// ─────────────────────────────────────────────────────────────────────────────
// User (tenant root)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                   String        @id @default(cuid())
  fullName             String
  email                String        @unique
  password             String        // bcrypt hash
  avatar               String?
  whatsapp             String?
  gender               String?
  maritalStatus        String?
  address              String?
  country              String?
  role                 String?
  experience           String?
  education            String?
  // Personalization profile (added by 20260807211257_add_user_profile_for_edith)
  hometown             String?
  university           String?
  degree               String?
  yearSemester         String?
  hobbies              String?
  interests            String?
  aiBio                String?
  // ─── Phase 7 — Structured profile fields ─────────────────────────────────
  // Keep single-value scalars on User (so /api/profile can SELECT them in one
  // round-trip). Multi-row sections (Address / Education / Skill) live in
  // their own models below.
  mobileNumber         String?
  ageRange             String?       // "20-25", "26-30", ...
  primaryDeviceType    String?       // "Laptop", "Mobile", "Tablet", "Desktop"
  employmentRole       String?       // "Student", "Freelancer", "Employee", ...
  areaType             String?       // "Urban", "Town", "Rural"
  points               Int           @default(0)
  weeklyPoints         Int           @default(0)
  dailyStreak          Int           @default(0)
  league               League        @default(BRONZE)
  isLeaderboardVisible Boolean       @default(true)
  lastTaskCompleteDate DateTime?
  theme                String        @default("light") // "light" | "dark"
  timezone             String        @default("UTC")
  pushNotifications    Boolean       @default(true)
  emailNotifications   Boolean       @default(true)
  reminderSound        Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  futureGoal    FutureGoal?
  targets       Target[]
  tasks         Task[]
  notes         Note[]
  courses       Course[]
  reminders     Reminder[]
  chats         ChatHistory[]
  addresses     Address[]
  educations    Education[]
  skills        Skill[]
  notifications Notification[]

  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 7 — Structured profile sub-records (1 user → N rows)
// ─────────────────────────────────────────────────────────────────────────────

enum AddressKind {
  PRESENT
  PERMANENT
}

/// One row per address section. We keep BOTH "present" and "permanent"
/// on the SAME row so the UI can render them in one SELECT. The
/// `sameAsPresent` flag lets the permanent section collapse when the
/// user opts in.
model Address {
  id            String      @id @default(cuid())
  userId        String
  kind          AddressKind
  country       String?
  district      String?
  streetAddress String?
  /// For PERMANENT rows only — when true the UI copies values from the
  /// PRESENT row at render time instead of using these columns.
  sameAsPresent Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

/// Education history — most users only have ONE active row but the model
/// allows multiple (e.g. HSC + Bachelor). The "currently studying"
/// checkbox is the truth source the UI uses to highlight the active row.
model Education {
  id                  String   @id @default(cuid())
  userId              String
  educationLevel      String?  // "SSC", "HSC", "Bachelor/Honors", "Masters", "PhD"
  examDegreeTitle     String?  // free text — "Computer Science and Engineering"
  institutionName     String?
  isCurrentlyStudying Boolean  @default(false)
  passingYear         Int?     // approximate passing year e.g. 2027
  currentYear         String?  // "1st Year", "2nd Year", "3rd Year", "4th Year"
  isCseStudent        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A single skill in the user's skill set. Multiple rows per user.
model Skill {
  id               String   @id @default(cuid())
  userId           String
  skillName        String
  experienceInYear String?  // "1", "2", "3+" — free string so UI can use dropdown
  projectLinks     String?  // newline-separated list of URLs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Future Goal (singleton per user — Life Path endpoint of the timeline)
// ─────────────────────────────────────────────────────────────────────────────

model FutureGoal {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// Target (with sub-tasks as Task rows where targetId is set)
// ─────────────────────────────────────────────────────────────────────────────

model Target {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  deadline    DateTime?
  priority    Priority     @default(MEDIUM)
  status      TargetStatus @default(INCOMPLETE)
  isPenalized Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  reminders Reminder[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task (standalone OR target sub-task via targetId)
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  userId      String
  targetId    String?
  title       String
  description String?
  deadline    DateTime?
  isCompleted Boolean   @default(false)
  priority    Priority  @default(MEDIUM) // inherited from target if targetId set
  isPenalized Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    Target?    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, isCompleted])
  @@index([userId, createdAt])
  @@index([userId, completedAt])
  @@index([targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Note
// ─────────────────────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Course
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id           String    @id @default(cuid())
  userId       String
  semester     String?
  title        String
  resourceLink String
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isCompleted])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reminder (polymorphic-ish: targetId OR taskId)
// ─────────────────────────────────────────────────────────────────────────────

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  targetId  String?
  taskId    String?
  time      DateTime
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target Target? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, time])
  @@index([userId, isSent])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Assistant chat
// ─────────────────────────────────────────────────────────────────────────────

model ChatHistory {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  sender    Sender
  content   String
  createdAt DateTime @default(now())

  chat ChatHistory @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("PENALTY") // "PENALTY" | "REMINDER" | "SYSTEM" | "INACTIVITY" | "STREAK_BREAK"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}