# ───────────────────────────────────────────────────────────────────────────
# Progress Copilot — API environment
# Copy to api/.env and fill in real values.
# ───────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string consumed by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/progress_copilot?schema=public"

# Secret used to sign JWTs. Use any 32+ char random string.
JWT_SECRET="change-me-to-a-long-random-string"

# Where the React app runs. Used by CORS.
CLIENT_ORIGIN="http://localhost:5173"

# Optional cookie / session tuning.
PORT=4000

# ─── AI Assistant (Phase 6) ────────────────────────────────────────────────
# Google Gemini API key — looks like "AIza..." or "AQ.Ab8...". Get one at
# https://aistudio.google.com. Without it the AI Assistant runs in offline
# mode and returns a friendly stub message — useful for local dev.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Gemini model identifier. Defaults to "gemini-flash-latest" (always points to
# the current Flash-tier stable release) when empty. See
# https://ai.google.dev/models for the full list. If the configured model is
# unavailable the service falls back to the in-code fallback list.
GEMINI_MODEL="gemini-flash-latest"
